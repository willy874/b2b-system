{
  "name": "@b2b-system/api-sdk",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "tsx ./codegen/cli.ts --input ../../apps/api/openapi.json --output ./src/generated && oxfmt ./src/generated",
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo codegen/dist-types",
    "typecheck": "tsc -b && tsc -b ./codegen",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "openapi-types": "^12.1.3",
    "tsx": "^4.20.6",
    "vitest": "^3.2.7"
  }
}
