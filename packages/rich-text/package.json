{
  "name": "@b2b-system/rich-text",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "schema": [
        "./dist/schema.d.ts"
      ],
      "html": [
        "./dist/html.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "default": "./dist/html.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "domhandler": "^6.0.1",
    "htmlparser2": "^12.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
