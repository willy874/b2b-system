# docker-compose.prod.yml 的變數範本（docs/architecture/01-system.md §4.2）。
#   cp deploy/prod.env.example deploy/prod.env   # deploy/*.env 不進版控、不進 build context
#   docker compose --env-file deploy/prod.env -f docker-compose.prod.yml up -d --build
#
# 不要沿用開發的 .env：compose 會拿它替換 ${…}，開發用的帳密與網域會流進正式環境。
# 金鑰另外存進秘密管理服務，與資料備份分開保存（§4.5）。含空白或特殊字元的值以單引號包起來。

# ── 必填：公開網址（瀏覽器看到的 origin；https、不能是 localhost）──────────────
# 預設租戶的 backstage；信裡的產品連結、presigned 網址的協定、Socket.io 的 Origin 白名單
PUBLIC_ORIGIN=https://app.example.com
# apps/platform（登入入口與平台管理）；OIDC issuer 是它底下的 /api/oidc
PLATFORM_PUBLIC_ORIGIN=https://accounts.example.com
# 第一次部署登記的預設租戶網域（瀏覽器看到的 host，含非預設的 port）
DEFAULT_TENANT_DOMAINS=app.example.com
# 新租戶的預設網域 {code}.<值>（要有 wildcard DNS 與憑證）；留空 = PUBLIC_ORIGIN 的 host
TENANT_BASE_DOMAIN=

# ── 必填：前置 LB ─────────────────────────────────────────────────────
# LB 連到 nginx 的來源網段（逗號分隔）：nginx 只採用它們帶來的 X-Forwarded-For。
# 例：同一個 VPC 的 ALB → VPC 的網段；同一台主機上的代理 → docker bridge 的閘道（docker network inspect）
TRUSTED_PROXY_CIDRS=10.0.0.0/16
# 8080／8081／8082 綁在哪個介面；LB 在別台主機時設成主機在 LB 那一側的位址，並以防火牆只讓 LB 連
EDGE_BIND_ADDRESS=127.0.0.1

# ── 必填：postgres（密碼會放進連線字串，用 URL 安全的字元：openssl rand -hex 24）────
POSTGRES_PASSWORD=
POSTGRES_PLATFORM_PASSWORD=
POSTGRES_TENANT_PASSWORD=
POSTGRES_PROVISIONER_PASSWORD=

# ── 選填：獨立的檔案網域（docs/architecture/backend/09-file.md §3.2）──────────────────────
# 下載與預覽改由這個 origin 提供（DNS 與憑證指向同一個 backstage 容器），使用者上傳的內容不會在租戶網域上被渲染。
# 留空 = 與租戶同源（只靠 sandbox CSP 與類型政策防護，api 啟動時會記一次警告）
FILE_DOWNLOAD_ORIGIN=

# ── 必填：金鑰（production 拒絕範例值與低熵的值；02-repository-structure.md §5）────────
# access token 的金鑰環：<kid>:<openssl rand -base64 48>，多把以逗號分隔、第一把簽發（backend/04-auth.md §11）。
# 租戶與平台必須是不同的金鑰。輪替：在最前面加一把新的、部署，過 JWT_ACCESS_TTL 之後刪掉舊的、再部署
JWT_SIGNING_KEYS=
PLATFORM_JWT_SIGNING_KEYS=
# 縮圖網址的 HMAC 金鑰：openssl rand -base64 48
FILE_URL_SIGNING_KEY=
# 舊的單一金鑰（選填）：從舊版升級時保留原值，讓換成金鑰環之前簽的 token 與縮圖網址在過渡期內仍有效；一小時後刪掉
JWT_SECRET=
# 各自 openssl rand -base64 32（32 bytes）
TENANT_SECRET_KEY=
IDP_SECRET_KEY=
WEBHOOK_SECRET_KEY=
MFA_SECRET_KEY=
# 平台管理者的 MFA（backend/21-mfa.md §13）：production 一律必須啟用；可用的方式預設 totp
PLATFORM_MFA_METHODS=totp
# 逗號分隔，每一把 openssl rand -base64 32；輪替時把新的放前面
OIDC_COOKIE_KEYS=
# 簽 ID token 的私鑰 JWKS（單行 JSON，以單引號包起來）；產生方式見 docs/architecture/04-sso.md §7
OIDC_JWKS=

# ── 必填：物件儲存（apps/file-storage；換成 S3 時改 compose 的 FILE_STORAGE_*）──────
FILE_STORAGE_ACCESS_KEY_ID=
# openssl rand -base64 32
FILE_STORAGE_SECRET_ACCESS_KEY=

# ── 前端錯誤收件（apps/apm-service，docs/architecture/07-apm-service.md）──────
# APM 整套的開關（§8.1）：下面兩行一起改。關閉 = APM_ENABLED=false 並拿掉 COMPOSE_PROFILES 的 apm：
#   apm-service 不建置、不啟動，前端不初始化錯誤回報，nginx 的 /apm/ 回 404；下面三個金鑰可以留空
APM_ENABLED=true
# compose 的 profile（逗號分隔）：apm（前端錯誤收件）、external（對外 API 與它的閘道）、
# worker（背景工作分開成 api-worker 容器；同時把 API_ROLES 設成 http,realtime，docs/architecture/01-system.md §7 D15）
COMPOSE_PROFILES=apm,external
# 開啟時必填（沒填 apm-service 啟動失敗）。兩個前端各自的 DSN public key（會出現在前端產物裡，不是秘密）：openssl rand -hex 16
APM_BACKSTAGE_PUBLIC_KEY=
APM_PLATFORM_PUBLIC_KEY=
# 上傳 sourcemap 與查詢 API 的 Bearer token：openssl rand -hex 24
APM_AUTH_TOKEN=

# ── 必填：郵件 ───────────────────────────────────────────────────────
# 服務商的 SMTP（smtps://user:pass@smtp.example.com:465）；寄件網域要設好 SPF / DKIM / DMARC
MAIL_SMTP_URL=
MAIL_FROM='B2B System <no-reply@example.com>'

# ── 必填：第一位管理者 ─────────────────────────────────────────────────
# 平台管理者：密碼留空 = 建成 pending，migrate 的日誌印出一次性的設定連結（1 小時有效）
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# 預設租戶的 super-admin：密碼留空 = 建成 pending，migrate 的日誌印出一次性的啟用連結（1 小時有效，不印密碼）
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── 選填（右邊是 compose 的預設值）─────────────────────────────────────
# TRUST_PROXY=uniquelocal              # api 信任哪一跳；docker 的位址池不在私有網段時改成那個子網路或 1
# POSTGRES_USER=b2bsystem
# POSTGRES_DB=b2b_system               # 預設租戶的 database
# PLATFORM_POSTGRES_DB=b2b_platform
# POSTGRES_MAX_CONNECTIONS=200         # 連線預算見 docs/architecture/backend/02-database.md §6.2
# POSTGRES_SHARED_BUFFERS=512MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
# POSTGRES_WORK_MEM=8MB
# POSTGRES_MEM_LIMIT=2g
# DEFAULT_TENANT_STORAGE_BUCKET=b2b-system
# TENANT_POOL_MAX=10
# TENANT_POOL_IDLE_TIMEOUT=30
# PLATFORM_POOL_MAX=10
# DB_CONNECT_TIMEOUT=10
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# UV_THREADPOOL_SIZE=16
# API_HEAP_MB=1536
# API_MEM_LIMIT=2g
# EXTERNAL_TENANT_POOL_MAX=5
# EXTERNAL_PLATFORM_POOL_MAX=5
# EXTERNAL_API_HEAP_MB=768
# EXTERNAL_API_MEM_LIMIT=1g
# FILE_STORAGE_MAX_OBJECT_SIZE=134217728     # 128 MiB，與 api 的影像轉出上限相同（backend/09-file.md）
# FILE_STORAGE_MEM_LIMIT=512m
# APP_RELEASE=unknown                  # 前端的 release（建置時寫進產物）；部署時帶 $(git rev-parse --short=7 HEAD)
# APM_TRACES_SAMPLE_RATE=0.1           # Web Vitals 的取樣率（0～1）
# APM_RETENTION_DAYS=30                # 錯誤事件保留天數
# APM_BIND_ADDRESS=127.0.0.1           # apm-service 的 9100（上傳 sourcemap、查詢 API、/metrics）綁在哪個介面
# APM_MEM_LIMIT=256m
# DEFAULT_RATE_LIMIT=600               # 速率限制（次 / 分）見 docs/architecture/backend/03-api-conventions.md §8
# ANONYMOUS_RATE_LIMIT=3000
# AUTH_RATE_LIMIT=10
# AUTH_IP_RATE_LIMIT=300
# AUTH_TENANT_RATE_LIMIT=1200
# 監控探針、內部服務的網段：豁免以 IP 計的限流（不豁免帳號層級的限制）
# RATE_LIMIT_EXEMPT_CIDRS=10.0.0.0/8
# ARGON2_MAX_CONCURRENCY=4           # argon2 同時執行的上限（每程序；依 CPU 與記憶體調整，見 backend/04-auth.md §4.1）
# REFRESH_RATE_LIMIT=30
# REFRESH_IP_RATE_LIMIT=2000
# REALTIME_HANDSHAKES_PER_IP=1200
# REALTIME_CONNECTIONS_PER_USER=20
# EXTERNAL_RATE_LIMIT=600
# EXTERNAL_AUTH_FAILURE_RATE_LIMIT=30
# MAIL_SMTP_POOL_SIZE=5

# ── 選填：圖片的 CDN（docker-compose.cdn.yml；docs/architecture/backend/09-file.md §16）────────
# 開關 = 要不要疊 -f docker-compose.cdn.yml（疊上時 api 的 FILE_CDN_ENABLED=true）；只能整個部署一起改，改了要重啟 api 的所有角色。
# 關掉之後邊緣（cdn）要再運作到 FILE_CDN_MAX_URL_TTL 過去才能停；重新打開前若關掉的時間比它短，先跑 cli:cdn-purge --all。
# 啟用時下面四個必填
# CDN_PUBLIC_ORIGIN=https://cdn.example.com   # 瀏覽器看到的 CDN origin（前置 LB 的 TLS 指到 cdn 的 8083）；也放進兩個前端的 CSP img-src
# FILE_CDN_SIGNING_KEYS=               # <kid>:<base64>[,…]，第一把簽發（openssl rand -base64 48）；api 與邊緣共用。輪替見 09-file.md §16.3
# FILE_CDN_PURGE_SECRET=               # 清理請求的 HMAC 金鑰（openssl rand -base64 48）；api 與邊緣共用
# FILE_STORAGE_ORIGIN_SECRET=          # 邊緣回源的憑證（openssl rand -hex 32）；file-storage 與邊緣共用
# FILE_CDN_RESOURCES=imageAsset,galleryItem,fileVariant   # 逐步開放：先只開 fileVariant 驗證
# FILE_CDN_MAX_URL_TTL=86400
# FILE_CDN_PURGE_ON_DELETE=true
# FILE_CDN_PURGE_BATCH_SIZE=100
# FILE_CDN_PURGE_TIMEOUT_MS=5000
# CDN_CACHE_MAX_SIZE=10g               # 邊緣快取的磁碟上限（滿了以 LRU 淘汰）
# CDN_CACHE_INACTIVE=30d               # 多久沒被讀取就刪除
# CDN_CACHE_VALID=30d                  # 快取的有效期（物件只寫一次）
# CDN_MEM_LIMIT=512m

# ── 選填：監控（docker-compose.monitoring.yml；docs/architecture/08-monitoring.md §6）────────
# 監控整套的開關（§1.1）= 要不要疊 -f docker-compose.monitoring.yml：沒疊時 api 預設 MONITORING_ENABLED=false（不開 /metrics、
# 不量指標、不送 trace），疊上時預設 true。要明確指定（例：外部的 Prometheus 抓 api、或疊著卻暫時關掉 api 端）才設
# MONITORING_ENABLED=true
# 啟用時下面兩個必填
# GRAFANA_ADMIN_PASSWORD=              # Grafana 的 admin 密碼（openssl rand -hex 24）
# POSTGRES_MONITOR_PASSWORD=           # postgres-exporter 的 b2b_monitor 角色；既有部署先跑 deploy/monitoring/create-monitor-role.sql
# GRAFANA_ROOT_URL=http://localhost:3300   # 瀏覽器看到的 Grafana 網址（經 SSH tunnel 或前置 LB）
# MONITORING_BIND_ADDRESS=127.0.0.1    # Grafana 的 3300 綁在哪個介面
# OTEL_TRACES_SAMPLER_ARG=0.2          # api 的 trace 取樣率（0～1）
# PROMETHEUS_RETENTION=30d             # 指標保留期限；另有容量上限 PROMETHEUS_RETENTION_SIZE=20GB
# TEMPO_RETENTION=168h                 # trace 保留期限
