          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/0/projects/b2b-system/$project/issues/?statsPeriod=$period&limit=100",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "id",
              "text": "id",
              "type": "string"
            },
            {
              "selector": "title",
              "text": "標題",
              "type": "string"
            },
            {
              "selector": "culprit",
              "text": "位置",
              "type": "string"
            },
            {
