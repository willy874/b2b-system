              "type": "string"
            },
            {
              "selector": "count",
              "text": "次數",
              "type": "number"
            },
            {
              "selector": "userCount",
              "text": "人數",
              "type": "number"
            },
            {
              "selector": "lastRelease",
              "text": "最後的 release",
              "type": "string"
            },
            {
              "selector": "firstSeen",
              "text": "第一次",
              "type": "timestamp"
            },
            {
              "selector": "lastSeen",
              "text": "最後一次",
              "type": "timestamp"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "標題"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "最新事件",
                    "url": "/d/b2b-frontend?${__url_time_range}&var-project=${project}&var-period=${period}&var-issue=${__data.fields.id}"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 420
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "標題": 0,
              "等級": 1,
              "次數": 2,
              "人數": 3,
              "最後的 release": 4,
              "最後一次": 5,
              "第一次": 6,
              "位置": 7,
              "id": 8
            }
          }
        }
      ],
