    {
      "type": "table",
      "title": "最耗時的查詢（pg_stat_statements，期間內）",
      "description": "只有正式環境（shared_preload_libraries=pg_stat_statements）有資料。以 queryid 在 Postgres 查 SQL：SELECT query FROM pg_stat_statements WHERE queryid = <id>。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(15, sum by (queryid, datname) (increase(pg_stat_statements_seconds_total[$__range])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(15, sum by (queryid, datname) (increase(pg_stat_statements_calls_total[$__range])))",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
