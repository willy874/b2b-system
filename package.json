{
  "name": "b2b-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:packages && pnpm db:up && pnpm mail:up && pnpm -r --parallel --filter \"./apps/api\" --filter \"./apps/backstage\" --filter \"./apps/auth\" --filter \"./apps/file-storage\" dev",
    "dev:api": "pnpm --filter @b2b-system/api dev",
    "dev:backstage": "pnpm --filter @b2b-system/backstage dev",
    "dev:auth": "pnpm --filter @b2b-system/auth dev",
    "dev:storage": "pnpm --filter @b2b-system/file-storage dev",
    "dev:mock-idp": "pnpm --filter @b2b-system/api mock-idp",
    "dev:e2e": "pnpm build:packages && pnpm mail:up && AUTH_RATE_LIMIT=1000 DEFAULT_RATE_LIMIT=10000 MAIL_TRANSPORT=smtp pnpm --filter @b2b-system/api dev",
    "storybook": "pnpm --filter @b2b-system/backstage storybook",
    "storybook:build": "pnpm --filter @b2b-system/backstage storybook:build",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "build": "pnpm --filter @b2b-system/api-sdk build && pnpm --filter @b2b-system/api build && pnpm --filter @b2b-system/backstage build && pnpm --filter @b2b-system/auth build",
    "db:up": "docker compose up -d postgres",
    "mail:up": "docker compose up -d mailpit",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @b2b-system/api db:generate",
    "db:migrate": "pnpm --filter @b2b-system/api db:migrate",
    "db:seed": "pnpm --filter @b2b-system/api db:seed",
    "db:seed:dev": "pnpm --filter @b2b-system/api db:seed:dev",
    "db:seed:e2e": "pnpm --filter @b2b-system/api db:seed:e2e",
    "db:reset": "pnpm --filter @b2b-system/api db:reset",
    "db:archive-audit-logs": "pnpm --filter @b2b-system/api db:archive-audit-logs",
    "db:drop-tenant": "pnpm --filter @b2b-system/api db:drop-tenant",
    "db:studio": "pnpm --filter @b2b-system/api db:studio",
    "sdk:generate": "pnpm --filter @b2b-system/api-sdk generate",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -b",
    "test": "pnpm -r --filter \"!@b2b-system/e2e\" test",
    "test:e2e": "pnpm --filter @b2b-system/e2e test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "lefthook": "^2.1.15",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.86.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "overrides": {
      "@vitest/mocker>msw": "^3.0.1"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "lefthook",
      "msw",
      "@node-rs/argon2"
    ]
  }
}
