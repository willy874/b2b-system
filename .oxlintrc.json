{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "unicorn", "react", "jsx-a11y", "oxc"],
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/dist-types/**",
    "**/node_modules/**",
    "**/coverage/**",
    "**/storybook-static/**",
    "packages/api-sdk/src/generated/**"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "warn",
    "eqeqeq": "error",
    "typescript/no-explicit-any": "warn",
    "import/no-cycle": "error",
    "import/no-unassigned-import": "off",
    "import/no-named-as-default": "off",
    "react/react-in-jsx-scope": "off",
    "react/no-unstable-nested-components": "off",
    "unicorn/prefer-node-protocol": "error"
  },
  "overrides": [
    {
      "files": [
        "apps/backstage/**/*.{ts,tsx}",
        "apps/platform/**/*.{ts,tsx}",
        "packages/**/*.{ts,tsx}"
      ],
      "rules": {
        "typescript/consistent-type-imports": "error"
      }
    },
    {
      "files": [
        "apps/backstage/src/**/*.{ts,tsx}",
        "apps/platform/src/**/*.{ts,tsx}",
        "packages/ui/src/**/*.{ts,tsx}",
        "packages/web-core/src/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@sigrea/core",
                "message": "只經由 @b2b-system/web-shared/store（React 綁定在 @b2b-system/web-shared/hooks）使用 signal。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/web-shared/src/context/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@sigrea/core",
                "message": "只經由 @b2b-system/web-shared/store（React 綁定在 @b2b-system/web-shared/hooks）使用 signal。"
              },
              {
                "name": "react",
                "message": "這一層不依賴 React；React 綁定放 web-shared 的 hooks/ 或 core/app/react.tsx。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/web-shared/src/store/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "這一層不依賴 React；React 綁定放 web-shared 的 hooks/ 或 core/app/react.tsx。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/web-shared/src/store/__tests__/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["apps/api/**/*.ts"],
      "env": {
        "browser": false
      },
      "rules": {
        "typescript/no-extraneous-class": "off",
        "typescript/consistent-type-imports": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/__tests__/**"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "no-console": "off"
      }
    },
    {
      "files": ["packages/ui/src/components/Table/**"],
      "rules": {
        "react/incompatible-library": "off",
        "react/no-array-index-key": "off"
      }
    },
    {
      "files": [
        "apps/api/src/db/**",
        "apps/api/scripts/**",
        "apps/e2e/**",
        "packages/api-sdk/scripts/**"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
