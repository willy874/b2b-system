{
  "name": "@b2b-system/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:cross-browser": "playwright test --grep @cross-browser",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc -b",
    "install:browsers": "playwright install --with-deps chromium",
    "tour": "playwright test -c playwright.tour.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
