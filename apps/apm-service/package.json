{
  "name": "@b2b-system/apm-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --sourcemap --outfile=dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "upload-sourcemaps": "tsx src/cli/upload-sourcemaps.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sentry/core": "^11.4.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
