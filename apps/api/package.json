{
  "name": "@game-editor/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "openapi:generate": "node -r @swc-node/register scripts/generate-openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seeds/index.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed:dev": "tsx src/db/seeds/dev.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:seed:e2e": "tsx src/db/seeds/e2e.ts",
    "db:archive-audit-logs": "tsx src/db/archive-audit-logs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@game-editor/realtime": "workspace:*",
    "@game-editor/utils": "workspace:*",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/platform-socket.io": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/websockets": "^11.2.6",
    "@node-rs/argon2": "^2.2.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.2",
    "nestjs-pino": "^5.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "proxy-addr": "^2.0.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.2.5",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.3",
    "@testcontainers/postgresql": "^10.28.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/proxy-addr": "^2.0.3",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.6",
    "testcontainers": "^10.28.0",
    "tsx": "^4.20.6",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.7"
  }
}
